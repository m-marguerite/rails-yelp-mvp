<% if false %>
  <div class="container my-4">
    <h2><%= @restaurant.name %></h2>
    <div class="card" style="background-color:#E0E0E0">
      <div class="card-body">
        <p><%= @restaurant.address %></p>
        <p><%= @restaurant.phone_number %></p>
        <p><%= @restaurant.category %></p>
      </div>
    </div>

    <hr>

    <p><strong>Reviews</strong></p>
    <ul class="list-group">
      <% @restaurant.reviews.each do |review| %>
        <li class="list-group-item">
          <%= review.rating %>/5 – <%= review.content %>
        </li>
      <% end %>
    </ul>

    <%= link_to "Add a review", new_restaurant_review_path(@restaurant),
      class: "btn btn-primary mt-3" %>

    <hr>

    <%= link_to "Back to list", restaurants_path, class: "text-decoration-none"%>
  </div>
<% end %>

<div class="container my-5">
  <%= link_to "← Back to list", restaurants_path, class: "text-decoration-none" %>

  <div class="card shadow-sm mt-3 mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start">
        <h1 class="card-title h2"><%= @restaurant.name %></h1>
        <span class="badge text-bg-primary fs-6"><%= @restaurant.category.capitalize %></span>
      </div>
      <p class="mb-1">📍 <%= @restaurant.address %></p>
      <p class="mb-0">📞 <%= @restaurant.phone_number %></p>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Reviews (<%= @restaurant.reviews.count %>)</h2>
    <%= link_to "Add a review", new_restaurant_review_path(@restaurant),
                class: "btn btn-primary" %>
  </div>

  <% if @restaurant.reviews.any? %>
    <div class="list-group shadow-sm">
      <% @restaurant.reviews.each do |review| %>
        <div class="list-group-item">
          <div class="text-warning fs-5">
            <%= "★" * review.rating %><span class="text-secondary"><%= "☆" * (5 - review.rating) %></span>
          </div>
          <p class="mb-0"><%= review.content %></p>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">No reviews yet. Be the first one!</div>
  <% end %>
</div>
